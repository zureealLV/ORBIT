  "engines": { "node": ">=22.12" },
  "dependencies": { "fflate": "0.8.3" },
  "devDependencies": { "typescript": "7.0.2", "vite": "8.3.4", "tsx": "4.23.15", "@types/node": "^24.0.0" }
}
